{
  "name": "wizp",
  "version": "0.1.0",
  "description": "WIZP — Ultra-lightweight code editor with Monaco frontend and Zig daemon backend",
  "private": true,
  "scripts": {
    "build": "./scripts/zigw.sh build -Doptimize=ReleaseSafe -Dtarget=x86_64-linux-gnu",
    "build:linux:self-contained": "./scripts/zigw.sh build -Doptimize=ReleaseSafe -Dtarget=x86_64-linux-musl",
    "build:headless": "./scripts/zigw.sh build -Doptimize=ReleaseSafe -Dtarget=x86_64-linux-gnu",
    "build:debug": "./scripts/zigw.sh build -Dtarget=x86_64-linux-gnu",
    "test": "./scripts/zigw.sh build test -Doptimize=ReleaseSafe -Dtarget=x86_64-linux-gnu",
    "check": "./scripts/zigw.sh build check -Doptimize=ReleaseSafe -Dtarget=x86_64-linux-gnu",
    "audit:dependencies": "npm audit --audit-level=high && cd frontend && npm audit --audit-level=high",
    "verify": "./scripts/verify.sh",
    "check:dependencies": "python3 scripts/check_dependency_consistency.py",
    "check:bundle-contract": "python3 scripts/check_bundled_frontend_contract.py",
    "check:package-layout": "python3 scripts/check_package_layout_contract.py",
    "check:release-workflow": "python3 scripts/check_release_workflow_contract.py",
    "check:release-evidence-runbook": "python3 scripts/check_release_evidence_runbook.py",
    "check:ui-ux-audit": "python3 scripts/check_ui_ux_audit_contract.py",
    "check:ui-visual": "python3 scripts/check_ui_visual_contract.py",
    "check:native-ui-baseline": "python3 scripts/check_native_ui_baseline_contract.py",
    "check:native-editor-report": "python3 scripts/check_native_editor_report.py",
    "check:extension-timing-boundary": "python3 scripts/check_extension_timing_boundary.py",
    "check:alpha-dispositions": "python3 scripts/check_alpha_dispositions.py",
    "check:cross-os-artifacts": "python3 scripts/check_cross_os_artifact_contract.py",
    "check:beta-readiness": "python3 scripts/check_beta_readiness_contract.py",
    "check:beta-handoff": "python3 scripts/check_beta_handoff_artifact.py",
    "test:beta-readiness": "python3 -m unittest scripts/test_beta_readiness_contract.py scripts/test_beta_handoff_artifact.py",
    "report:dependency-updates": "python3 scripts/dependency_update_report.py",
    "report:release-artifacts": "python3 scripts/release_artifact_report.py",
    "test:package-audit": "python3 -m unittest scripts/test_package_self_contained_audit.py",
    "test:top20-utils": "python3 scripts/test_top20_parity_utils.py",
    "test:top20-status": "python3 scripts/test_top20_scenario_status.py",
    "test:top20-paths": "python3 scripts/test_top20_artifact_paths.py",
    "test:top20-loading": "python3 scripts/test_top20_artifact_loading.py",
    "test:ui-contract": "python3 scripts/test_ui_contract.py",
    "test:parity:boundary": "python3 scripts/check_core_extension_boundary.py",
    "test:parity:daemon": "python3 scripts/parity_daemon_smoke.py",
    "test:parity:frontend": "python3 scripts/parity_frontend_smoke.py",
    "test:parity:recovery": "python3 scripts/parity_recovery_smoke.py",
    "test:parity:playwright": "npm run build:frontend && npm run build && node scripts/parity_playwright_smoke.mjs",
    "test:parity:extension": "python3 scripts/parity_extension_host_smoke.py",
    "test:parity:lightweight": "python3 scripts/lightweight_default_report.py",
    "test:parity": "npm run test:parity:boundary && npm run build && npm run test:parity:daemon && npm run test:parity:frontend && npm run test:parity:extension && npm run test:parity:lightweight",
    "benchmark:startup": "node scripts/benchmark-startup.js",
    "benchmark:gui-startup": "node scripts/benchmark-gui-startup.js",
    "package:fixture:basic-api-smoke": "python3 scripts/package_basic_api_smoke_vsix.py",
    "build:frontend": "cd frontend && npm run build",
    "build:vsix": "cd extension && ./build-vsix.sh",
    "dev:electrobun": "electrobun dev",
    "build:electrobun": "electrobun build",
    "vendor:linux-runtime": "python3 scripts/vendor_linux_runtime_deps.py",
    "prune:linux-package": "python3 scripts/prune_linux_package.py --strip",
    "report:api-drift": "python3 scripts/vscode_api_drift_report.py",
    "report:network-policy": "python3 scripts/network_policy_report.py",
    "report:lightweight-default": "python3 scripts/lightweight_default_report.py",
    "report:cross-os-artifacts": "python3 scripts/cross_os_artifact_report.py",
    "report:stress-trend": "python3 scripts/stress_trend_report.py",
    "report:frontend-bundle": "npm run build:frontend && python3 scripts/frontend_bundle_report.py --fresh",
    "report:openvsx-top": "python3 scripts/openvsx_top_extensions_report.py",
    "report:top20-behavior": "python3 scripts/top20_behavior_parity_smoke.py --write-scenarios",
    "report:beta-readiness": "python3 scripts/beta_readiness_report.py",
    "status:beta-gates": "python3 scripts/beta_gate_status.py",
    "status:beta-gates:non-os": "python3 scripts/beta_gate_status.py --ignore-cross-os",
    "test:budget-gate": "python3 scripts/check_h11e_budget_gate.py",
    "test:alpha-dispositions": "python3 scripts/check_alpha_dispositions.py",
    "check:native-visual-baselines": "python3 scripts/check_native_visual_baselines.py",
    "test:native-visual-baselines": "python3 -m unittest scripts/test_native_visual_baselines.py",
    "test:terminal-resource-report": "python3 -m unittest scripts/test_terminal_resource_report.py && python3 scripts/check_terminal_resource_report.py",
    "test:native-ui-baseline-utils": "python3 -m unittest scripts/test_native_ui_baseline_smoke.py",
    "test:native-report-promotion": "python3 -m unittest scripts/test_native_report_promotion.py",
    "test:native-ui-baseline": "./scripts/run_virtual_ui_test.sh python3 scripts/native_ui_baseline_smoke.py",
    "test:native-settings": "./scripts/run_virtual_ui_test.sh python3 scripts/native_settings_smoke.py",
    "check:native-settings-report": "python3 scripts/check_native_settings_report.py",
    "test:native-explorer": "./scripts/run_virtual_ui_test.sh python3 scripts/native_explorer_smoke.py",
    "check:native-explorer-report": "python3 scripts/check_native_explorer_report.py",
    "test:native-search": "./scripts/run_virtual_ui_test.sh python3 scripts/native_search_smoke.py",
    "check:native-search-report": "python3 scripts/check_native_search_report.py",
    "test:native-editor": "./scripts/run_virtual_ui_test.sh python3 scripts/native_editor_smoke.py",
    "test:native-editor:scheduled": "./scripts/run_virtual_ui_test.sh python3 scripts/native_editor_smoke.py --native-save-dialog",
    "test:native-scm": "./scripts/run_virtual_ui_test.sh python3 scripts/native_primary_journey_smoke.py --journey scm",
    "check:native-scm-report": "python3 scripts/check_native_primary_journey_report.py --journey scm",
    "test:native-debug": "./scripts/run_virtual_ui_test.sh python3 scripts/native_primary_journey_smoke.py --journey debug",
    "check:native-debug-report": "python3 scripts/check_native_primary_journey_report.py --journey debug",
    "test:native-extensions": "./scripts/run_virtual_ui_test.sh python3 scripts/native_primary_journey_smoke.py --journey extensions",
    "check:native-extensions-report": "python3 scripts/check_native_primary_journey_report.py --journey extensions",
    "test:native-terminal": "./scripts/run_virtual_ui_test.sh python3 scripts/native_primary_journey_smoke.py --journey terminal",
    "check:native-terminal-report": "python3 scripts/check_native_primary_journey_report.py --journey terminal",
    "test:native-recovery": "./scripts/run_virtual_ui_test.sh python3 scripts/native_primary_journey_smoke.py --journey recovery",
    "check:native-recovery-report": "python3 scripts/check_native_primary_journey_report.py --journey recovery",
    "test:startup-benchmark": "python3 scripts/check_startup_benchmark.py",
    "test:stress-ci-history": "python3 scripts/check_stress_ci_history.py",
    "test:optional-mode-matrix": "python3 scripts/check_optional_mode_matrix.py",
    "test:performance-baselines": "python3 scripts/check_performance_baselines.py",
    "audit:package": "python3 scripts/package_self_contained_audit.py --require-cef --strict-static-backend --require-fresh-assets --report build/parity-package/bundled-package-audit.json",
    "audit:self-contained": "python3 scripts/package_self_contained_audit.py --require-cef --strict-static-backend --fail-on-system-webview --fail-on-external-deps --require-fresh-assets --report build/parity-package/self-contained-strict-audit.json",
    "build:self-contained": "npm run build:frontend && npm run build:linux:self-contained && npm run build:electrobun && npm run vendor:linux-runtime && npm run prune:linux-package && npm run audit:package && npm run audit:self-contained"
  },
  "dependencies": {
    "electrobun": "1.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
