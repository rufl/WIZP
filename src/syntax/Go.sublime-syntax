%YAML 1.2
---
name: Go
file_extensions:
  - go
scope: source.go
variables:
  ident: '[a-zA-Z_][a-zA-Z0-9_]*'
contexts:
  main:
    - match: //[^\n]*
      scope: comment.line.double-slash.go
    - match: /\*
      scope: comment.block.go
      push:
        - match: \*/
          scope: comment.block.go
          pop: true
    - match: '"'
      scope: string.quoted.double.go
      push: string-double
    - match: '`[^`]*`'
      scope: string.quoted.raw.go
    - match: '\b(func|package|import|if|else|for|range|switch|case|default|break|continue|return|go|defer|select|chan|type|struct|interface|map|var|const|goto|fallthrough)\b'
      scope: keyword.control.go
    - match: '\b(bool|byte|complex64|complex128|error|float32|float64|int|int8|int16|int32|int64|rune|string|uint|uint8|uint16|uint32|uint64|uintptr|nil|true|false|iota|any|comparable)\b'
      scope: storage.type.go
    - match: '\b(append|cap|close|complex|copy|delete|imag|len|make|new|panic|print|println|real|recover)\b'
      scope: support.function.builtin.go
    - match: '\b([0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+)\b'
      scope: constant.numeric.go
    - match: '{{ident}}\s*(?=\()'
      scope: entity.name.function.go
    - match: '\b{{ident}}\b'
      scope: variable.other.go
    - match: '[+\-*/%&|^~!<>=?:;,.(){}[\]]+|:=|<-'
      scope: keyword.operator.go
  string-double:
    - meta_scope: string.quoted.double.go
    - match: '\\.'
      scope: constant.character.escape.go
    - match: '"'
      scope: string.quoted.double.go
      pop: true
